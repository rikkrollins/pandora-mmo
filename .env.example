# Copy this file to .env and fill in your real values.

BOT_TOKEN=your-telegram-bot-token-here

# Ollama connection
OLLAMA_BASE_URL=http://localhost:11434

# Model routing
BUILD_MODEL=lfm2.5-thinking:latest
DM_NARRATION_MODEL=lfm2.5-thinking:latest

# Telegram forum topic thread IDs for this group
TOPIC_MAIN_ID=1
TOPIC_SUPPORT_ID=22
TOPIC_ADVENTURE_ID=23
TOPIC_DEVELOPMENT_ID=41

# The group's own chat id (get it via @userinfobot/@RawDataBot — forward
# any message from the group to it). Needed only for
# scripts/announce_deploy.py to post deploy updates to Development.
TELEGRAM_CHAT_ID=

# Database file path
DB_PATH=pandora_mmo.db

# GitHub personal access token, used only for git push auth from this
# machine (scripts/rotate_github_token.py rotates it). Never committed —
# .env is gitignored.
GITHUB_TOKEN=
